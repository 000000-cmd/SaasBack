# Plantilla del entorno local. Copiala a `.env` y rellena los valores.
#
# `.env` NO se versiona: lleva contrasenas. Estuvo versionado por error y se
# saco del indice; las claves que llego a publicar se rotaron.
#
#   cp .env.example .env
#
# ===========================================
# BASE DE DATOS MYSQL
# ===========================================
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=saas_db

# ===========================================
# TIMEZONE
# ===========================================
TZ=America/Bogota

# ===========================================
# KAFKA
# ===========================================
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Dev local: solo levantamos kafka-1.
# Prod: borrar/comentar este bloque -> defaults 3 voters / RF=3 / ISR=2.
KAFKA_QUORUM_VOTERS=1@kafka-1:9093
KAFKA_INTERNAL_RF=1
KAFKA_INTERNAL_MIN_ISR=1
KAFKA_TOPIC_RF=1
KAFKA_TOPIC_MIN_ISR=1

# Heap por nodo ES.
#   Dev (1 nodo single-node): 1g recomendado.
#   Prod (3 nodos cluster): 1g por nodo (3GB total) o subir a 2g si el volumen lo justifica.
ES_JAVA_OPTS=-Xms1g -Xmx1g

KIBANA_ENCRYPTION_KEY=

# Elasticsearch
ELASTIC_PASSWORD=

# ===========================================
# NOTAS:
# - NO usar MYSQL_USER/MYSQL_PASSWORD
# - NO usar SPRING_PROFILES_ACTIVE aquí
# - Cada servicio define su profile en docker-compose.yml
# ===========================================

# WhatsApp. En desarrollo son valores de juguete: sirven para poder firmar
# el webhook en las pruebas. Las credenciales de SALIDA
# (WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_ACCESS_TOKEN) las da Meta y son del
# dueño de la cuenta: sin ellas el canal queda como NO_PROVIDER.
SECRETS_KEY=
BOOKING_LINK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
